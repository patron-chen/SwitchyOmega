.page-header
  h2 {{'options_tab_general' | tr}}
section.settings-group
  h3 {{'options_group_networkRequests' | tr}}
  div.checkbox
    label
      input#revert-proxy-changes(type='checkbox' ng-model='options["-monitorWebRequests"]')
      span {{'options_monitorWebRequests' | tr}}
    p.help-block(omega-html="'options_monitorWebRequestsHelp' | tr")
  p
    a.btn.btn-default(href="./popup/network/index.html" role="button" target="_blank")
      span.glyphicon.glyphicon-dashboard
      = ' '
      | {{'Network monitor'}}
    span.help-inline {{'Inspect network traffic'}}
section.settings-group.width-limit
  h3 {{'options_downloadOptions' | tr}}
  p.help-block {{'options_downloadOptionsHelp' | tr}}
  .form-group
    label(for='download-interval') {{'options_downloadInterval' | tr}}
    select#download-interval.form-control.inline-form-control(ng-model='options["-downloadInterval"]'
      ng-options='interval as (downloadIntervalI18n(interval) | tr) for interval in downloadIntervals')
  .form-group
    label(for='geosite-update-url') {{'options_geositeUpdateUrl' | tr}}
    input#geosite-update-url.form-control(type='url' ng-model='options["-geositeUpdateUrl"]')
    p.help-block {{'options_geositeUpdateUrlHelp' | tr}}
  .form-group
    label(for='geosite-download-interval') {{'options_geositeDownloadInterval' | tr}}
    select#geosite-download-interval.form-control.inline-form-control(ng-model='options["-geositeDownloadInterval"]'
      ng-options='interval as (downloadIntervalI18n(interval) | tr) for interval in downloadIntervals')
  .form-group
    button.btn.btn-default(type='button' ng-click='updateGeosite()'
        ladda='geositeUpdating' data-spinner-color="#000000")
      | #[span.glyphicon.glyphicon-download-alt] {{'options_downloadGeositeNow' | tr}}
    p.help-block(ng-if='geositeInfo.lastUpdate')
      | {{'options_geositeLastUpdate' | tr:[geositeInfo.lastUpdate, geositeInfo.groupCount || 0]}}
    p.help-block.text-danger(ng-if='geositeInfo.error')
      | {{'options_geositeLastError' | tr:[geositeInfo.error.message || geositeInfo.error.name]}}
section.settings-group.width-limit-xl(ng-if='proxyEnvironmentSupported')
  h3 {{'options_group_proxyEnvironment' | tr}}
  .checkbox
    label
      input#proxy-environment-enabled(type='checkbox'
        ng-model='options["-proxyEnvironmentEnabled"]')
      span {{'options_proxyEnvironmentEnabled' | tr}}
    p.help-block {{'options_proxyEnvironmentHelp' | tr}}
  p.help-block {{'options_proxyEnvironmentProfilesHelp' | tr}}
  .table-responsive
    table.table.table-bordered.table-condensed.proxy-environment-profiles
      thead
        tr
          th.proxy-environment-current {{'options_proxyEnvironmentCurrent' | tr}}
          th {{'options_proxyEnvironmentProfileName' | tr}}
          th {{'options_proxyEnvironmentTimezone' | tr}}
          th {{'options_proxyEnvironmentLanguage' | tr}}
          th.proxy-environment-actions
      tbody
        tr(ng-repeat='profile in options["-proxyEnvironmentProfiles"] track by profile.id')
          td.proxy-environment-current
            input(type='radio' name='proxyEnvironmentActiveProfile'
              ng-model='options["-proxyEnvironmentActiveProfileId"]'
              ng-value='profile.id' ng-change='syncProxyEnvironmentProfile()'
              title='{{"options_proxyEnvironmentCurrent" | tr}}')
          td
            input.form-control(type='text' ng-model='profile.name' required
              data-proxy-environment-name='{{profile.id}}'
              ui-validate='{unique: "validateProxyEnvironmentName($value, profile.id)"}')
          td
            input.form-control(type='text' list='proxy-environment-timezones'
              ng-model='profile.timezone' required
              ui-validate='{timezone: "validateProxyEnvironmentTimezone($value)"}')
          td
            input.form-control(type='text' ng-model='profile.language' required
              ng-blur='normalizeProxyEnvironmentLanguage(profile)'
              ui-validate='{language: "validateProxyEnvironmentLanguage($value)"}')
          td.proxy-environment-actions
            button.btn.btn-danger.btn-sm(type='button'
              ng-click='removeProxyEnvironmentProfile(profile.id)'
              ng-disabled='options["-proxyEnvironmentProfiles"].length <= 1'
              title='{{"options_proxyEnvironmentDelete" | tr}}')
              span.glyphicon.glyphicon-trash
  datalist#proxy-environment-timezones
    option(ng-repeat='timezone in proxyEnvironmentTimezones' value='{{timezone}}')
  button.btn.btn-default(type='button' ng-click='addProxyEnvironmentProfile()')
    span.glyphicon.glyphicon-plus
    = ' '
    | {{'options_proxyEnvironmentAdd' | tr}}
  p.help-block {{'options_proxyEnvironmentTimezoneHelp' | tr}}
  p.help-block {{'options_proxyEnvironmentLanguageHelp' | tr}}
section.settings-group.width-limit
  h3 {{'options_group_conflicts' | tr}}
  p {{'options_conflicts_introduction' | tr}}
  p.help-text.text-danger
    span(style='padding: 1px 4px; background: #da4f49; color: #fff; box-shadow: #ccc 1px 1px 1px 1px;') =
    = ' '
    | {{'options_conflicts_lowerPriority' | tr}}
  p.help-text.text-info
    span.glyphicon.glyphicon-info-sign
    = ' '
    span(omega-html="'options_conflicts_higherPriority' | tr:[$profile('systemProfile')]")

  div.checkbox
    label
      input#revert-proxy-changes(type='checkbox' ng-model='options["-showExternalProfile"]')
      span {{'options_showExternalProfile' | tr}}
  p.help-block(omega-html="'options_showExternalProfileHelp' | tr:[$profile('systemProfile'), $profile('externalProfile')]")
